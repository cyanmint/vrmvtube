[gd_scene load_steps=5 format=3 uid="uid://d2w8nkphxc7qy"]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_1"]
[ext_resource type="Script" path="res://scripts/camera_controller.gd" id="2_1"]
[ext_resource type="Script" path="res://scripts/webcam_tracker.gd" id="3_1"]
[ext_resource type="Script" path="res://scripts/face_rigging.gd" id="4_1"]

[node name="Main" type="Node3D"]
script = ExtResource("1_1")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 3)
fov = 60.0
script = ExtResource("2_1")

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.707107, 0.707107, 0, -0.707107, 0.707107, 0, 3, 3)
shadow_enabled = true

[node name="Environment" type="WorldEnvironment" parent="."]

[node name="UI" type="CanvasLayer" parent="."]

[node name="Control" type="Control" parent="UI"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="UI/Control"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 120.0
grow_horizontal = 2

[node name="MarginContainer" type="MarginContainer" parent="UI/Control/VBoxContainer"]
layout_mode = 2
theme_override_constants/margin_top = 10

[node name="Title" type="Label" parent="UI/Control/VBoxContainer/MarginContainer"]
layout_mode = 2
text = "VRMVTube - VTubing with VRM Models"
horizontal_alignment = 1
vertical_alignment = 1

[node name="ButtonContainer" type="HBoxContainer" parent="UI/Control/VBoxContainer"]
layout_mode = 2
alignment = 1

[node name="LoadModelButton" type="Button" parent="UI/Control/VBoxContainer/ButtonContainer"]
layout_mode = 2
text = "Load VRM Model"

[node name="InfoLabel" type="Label" parent="UI/Control/VBoxContainer"]
layout_mode = 2
text = "Loading... Webcam tracking will start automatically.
Controls: Drag to rotate | Shift+Drag to pan | Scroll to zoom"
horizontal_alignment = 1

[node name="BottomPanel" type="VBoxContainer" parent="UI/Control"]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -80.0
grow_horizontal = 2
grow_vertical = 0

[node name="Credits" type="Label" parent="UI/Control/BottomPanel"]
layout_mode = 2
text = "Powered by godot-vrm (V-Sekai) | Inspired by VRigUnity"
horizontal_alignment = 1
vertical_alignment = 2

[node name="PlatformInfo" type="Label" parent="UI/Control/BottomPanel"]
layout_mode = 2
text = "Platform: Unknown"
horizontal_alignment = 1

[node name="FileDialog" type="FileDialog" parent="."]
title = "Select VRM Model"
size = Vector2i(800, 600)
ok_button_text = "Load"
file_mode = 0
access = 2
filters = PackedStringArray("*.vrm ; VRM Model Files")

[node name="WebcamTracker" type="Node" parent="."]
script = ExtResource("3_1")

[node name="FaceRigging" type="Node" parent="."]
script = ExtResource("4_1")

[connection signal="pressed" from="UI/Control/VBoxContainer/ButtonContainer/LoadModelButton" to="." method="_on_load_model_button_pressed"]
[connection signal="file_selected" from="FileDialog" to="." method="_on_file_selected"]
[connection signal="face_tracking_updated" from="WebcamTracker" to="FaceRigging" method="apply_tracking_data"]
