extends Control

# Main script for VRMVTube application
# Handles UI interactions and coordinates VRM model loading and tracking

@onready var status_label: Label = $VBoxContainer/StatusLabel
@onready var vrm_model_node: Node3D = $VBoxContainer/ContentContainer/ViewportContainer/SubViewport/VRMModel
@onready var load_vrm_button: Button = $VBoxContainer/ButtonsContainer/LoadVRMButton
@onready var start_tracking_button: Button = $VBoxContainer/ButtonsContainer/StartTrackingButton
@onready var camera_texture_rect: TextureRect = $VBoxContainer/ContentContainer/CameraPreview

var current_vrm_model: Node = null
var tracking_active: bool = false
var default_model_path: String = "res://assets/models/cyanmint.vrm"

# Tracking managers
var hand_tracking: HandTrackingManager
var face_tracking: FaceTrackingManager

# Camera feed
var camera_feed: CameraFeed
var camera_texture: CameraTexture
var frame_count: int = 0

func _ready() -> void:
	print("VRMVTube started")
	print("Godot version: ", Engine.get_version_info())
	_update_status("Ready - Load a VRM model to begin")
	start_tracking_button.disabled = true
	
	# Initialize tracking managers
	hand_tracking = HandTrackingManager.new()
	face_tracking = FaceTrackingManager.new()
	add_child(hand_tracking)
	add_child(face_tracking)
	
	# Connect signals
	hand_tracking.hand_landmarks_updated.connect(_on_hand_landmarks_updated)
	hand_tracking.tracking_error.connect(_on_tracking_error)
	face_tracking.face_landmarks_updated.connect(_on_face_landmarks_updated)
	face_tracking.face_blendshapes_updated.connect(_on_face_blendshapes_updated)
	face_tracking.tracking_error.connect(_on_tracking_error)
	
	# Check if plugins are available
	_check_plugins()
	
	# Setup camera preview
	_setup_camera()
	
	# Load default model if available
	if FileAccess.file_exists(default_model_path):
		_update_status("Loading default model...")
		call_deferred("_load_default_model")

func _check_plugins() -> void:
	# Check VRM plugin
	var vrm_available = ClassDB.class_exists("GLTFDocumentExtension")
	print("VRM support available: ", vrm_available)
	
	# Check GDMP plugin (MediaPipe)
	var gdmp_available = ClassDB.class_exists("MediaPipeHandLandmarker")
	print("GDMP (MediaPipe) support available: ", gdmp_available)
	
	if not vrm_available:
		_update_status("Warning: VRM plugin not detected")
	if not gdmp_available:
		_update_status("Warning: GDMP (MediaPipe) plugin not detected. Tracking will be unavailable.")

func _setup_camera() -> void:
	# Setup camera preview
	if CameraServer.get_feed_count() > 0:
		camera_feed = CameraServer.get_feed(0)
		if camera_feed:
			camera_texture = CameraTexture.new()
			camera_texture.camera_feed_id = camera_feed.get_id()
			camera_texture_rect.texture = camera_texture
			print("[Camera] Camera feed initialized")
	else:
		print("[Camera] No camera feed available")

func _load_default_model() -> void:
	_on_vrm_file_selected(default_model_path)

func _update_status(message: String) -> void:
	status_label.text = "Status: " + message
	print("[Status] " + message)

func _on_load_vrm_button_pressed() -> void:
	_update_status("Opening file dialog...")
	# Use FileDialog to select VRM file
	var file_dialog = FileDialog.new()
	file_dialog.file_mode = FileDialog.FILE_MODE_OPEN_FILE
	file_dialog.access = FileDialog.ACCESS_FILESYSTEM
	file_dialog.add_filter("*.vrm", "VRM Models")
	file_dialog.file_selected.connect(_on_vrm_file_selected)
	file_dialog.canceled.connect(func(): _update_status("File selection canceled"))
	add_child(file_dialog)
	file_dialog.popup_centered_ratio(0.6)

func _on_vrm_file_selected(path: String) -> void:
	_update_status("Loading VRM model: " + path)
	print("Loading VRM from: ", path)
	
	# Clear existing model
	if current_vrm_model:
		vrm_model_node.remove_child(current_vrm_model)
		current_vrm_model.queue_free()
		current_vrm_model = null
	
	# Load VRM model
	# VRM files are automatically imported by godot-vrm plugin as .scn files
	var loaded_scene = load(path)
	if loaded_scene and loaded_scene is PackedScene:
		current_vrm_model = loaded_scene.instantiate()
		vrm_model_node.add_child(current_vrm_model)
		_update_status("VRM model loaded successfully!")
		start_tracking_button.disabled = false
	else:
		_update_status("Failed to load VRM model")
		push_error("Could not load VRM from: " + path)

func _on_start_tracking_button_pressed() -> void:
	tracking_active = not tracking_active
	
	if tracking_active:
		_update_status("Starting MediaPipe tracking...")
		start_tracking_button.text = "Stop Tracking"
		# TODO: Initialize MediaPipe hand/face tracking via GDMP
		_start_tracking()
	else:
		_update_status("Stopping tracking...")
		start_tracking_button.text = "Start Tracking"
		# TODO: Stop MediaPipe tracking
		_stop_tracking()

func _start_tracking() -> void:
	print("Starting tracking")
	
	# Initialize tracking managers
	var hand_init = hand_tracking.initialize()
	var face_init = face_tracking.initialize()
	
	if not hand_init and not face_init:
		_update_status("Failed to initialize tracking")
		tracking_active = false
		start_tracking_button.text = "Start Tracking"
		return
	
	# Start tracking
	if hand_init:
		hand_tracking.start_tracking()
	if face_init:
		face_tracking.start_tracking()
	
	_update_status("Tracking active")

func _stop_tracking() -> void:
	print("Stopping tracking")
	hand_tracking.stop_tracking()
	face_tracking.stop_tracking()
	_update_status("Tracking stopped")

func _process(_delta: float) -> void:
	if tracking_active and camera_feed and camera_feed.feed_is_active:
		# Process camera frames
		var image := camera_texture.get_image()
		if image:
			var timestamp_ms := Time.get_ticks_msec()
			hand_tracking.process_frame(image, timestamp_ms)
			face_tracking.process_frame(image, timestamp_ms)

func _on_hand_landmarks_updated(landmarks: Array) -> void:
	# Update VRM model with hand landmarks
	# TODO: Map hand landmarks to VRM hand bones
	pass

func _on_face_landmarks_updated(landmarks: Array) -> void:
	# Update VRM model with face landmarks
	# TODO: Map face landmarks to VRM head orientation
	pass

func _on_face_blendshapes_updated(blendshapes) -> void:
	# Update VRM model with face blendshapes
	if not current_vrm_model:
		return
	
	# Convert MediaPipe blendshapes to VRM format
	var vrm_blendshapes = face_tracking.get_vrm_blendshapes(blendshapes)
	
	# Apply to VRM model
	_apply_vrm_blendshapes(vrm_blendshapes)

func _apply_vrm_blendshapes(blendshapes: Dictionary) -> void:
	# Apply blendshapes to VRM model
	# VRM models have MeshInstance3D nodes with blend shapes
	if not current_vrm_model:
		return
	
	# Find all MeshInstance3D nodes in the VRM model
	var mesh_instances := _find_mesh_instances(current_vrm_model)
	for mesh_instance in mesh_instances:
		if mesh_instance is MeshInstance3D:
			var mesh: Mesh = mesh_instance.mesh
			if mesh and mesh.get_blend_shape_count() > 0:
				# Try to map and apply blendshapes
				for i in range(mesh.get_blend_shape_count()):
					var shape_name: String = mesh.get_blend_shape_name(i)
					if shape_name in blendshapes:
						var value: float = blendshapes[shape_name]
						mesh_instance.set_blend_shape_value(i, value)

func _find_mesh_instances(node: Node) -> Array:
	var meshes := []
	if node is MeshInstance3D:
		meshes.append(node)
	for child in node.get_children():
		meshes.append_array(_find_mesh_instances(child))
	return meshes

func _on_tracking_error(error_message: String) -> void:
	_update_status("Tracking error: " + error_message)
	push_error("[Tracking] " + error_message)
